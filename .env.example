# Required in production. Find these in Supabase: Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional: forwards allow-listed events to PostHog from the server.
POSTHOG_API_KEY=phc_replace_me
POSTHOG_HOST=https://us.i.posthog.com

# Public canonical URL used for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://pingback.example.com

# Replace on legal pages before production.
NEXT_PUBLIC_CONTACT_EMAIL=privacy@YOUR-DOMAIN.com
NEXT_PUBLIC_LEGAL_NAME=YOUR LEGAL ENTITY NAME
